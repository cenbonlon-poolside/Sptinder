# Spotify API Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Database - PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/sptinder

# JWT Secret - Minimum 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Encryption Key - Exactly 32 characters for AES-256-GCM
# Used to encrypt refresh tokens at rest
# Generate with: openssl rand -base64 32 | head -c 32
ENCRYPTION_KEY=your_32_char_encryption_key_here

# Server port
PORT=3000

# Environment
NODE_ENV=development