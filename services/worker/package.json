{
  "name": "sptinder-worker",
  "version": "1.0.0",
  "description": "Worker service for Sptinder - Background job processing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "worker",
    "background-jobs",
    "spotify",
    "recommendations",
    "typescript"
  ],
  "author": "Sptinder Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "redis": "^4.6.8",
    "bullmq": "^4.15.0",
    "jsonwebtoken": "^9.0.1",
    "winston": "^3.9.0",
    "compression": "^1.7.4",
    "spotify-web-api-node": "^5.0.2",
    "@prisma/client": "^5.1.1",
    "prisma": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.5",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/jsonwebtoken": "^9.0.2",
    "typescript": "^5.1.6",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.6.1",
    "@types/jest": "^29.5.3",
    "ts-jest": "^29.1.1",
    "eslint": "^8.45.0",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0"
  }
}